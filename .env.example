# TREZO configuration. Copy to .env.local. Every value is optional for local play.
# NEVER commit real keys or secrets. .env.local is git-ignored.

# --- Public (compiled into the browser bundle at `npm run build`) ---------------
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Account the TREZO contract is deployed to. Leave empty to run without on-chain features.
NEXT_PUBLIC_TREZO_CONTRACT_ID=
# Optional custom RPC (defaults: https://test.rpc.fastnear.com / https://free.rpc.fastnear.com)
NEXT_PUBLIC_NEAR_RPC_URL=
# Optional MapLibre style URLs, comma separated, tried in order (key-less OSM-based defaults)
NEXT_PUBLIC_MAP_STYLE_URLS=
# Demo exploration zone (clearly labelled, simulated position)
NEXT_PUBLIC_DEMO_LAT=40.7812
NEXT_PUBLIC_DEMO_LNG=-73.9665
NEXT_PUBLIC_DEMO_NAME=Central Park Demo Zone

# --- Server secrets --------------------------------------------------------------
# Signs claim tickets after server-side validation. Generate with `npm run oracle:keygen`.
TREZO_ORACLE_SECRET_KEY=
# HMAC secret for admin cookies (>= 16 chars). Required in production.
TREZO_SESSION_SECRET=
# Admin dashboard (/admin): token login and/or wallet-authenticated NEAR accounts (comma separated).
# In development a default token "trezo-admin-dev" is used if this is empty.
TREZO_ADMIN_TOKEN=
TREZO_ADMIN_ACCOUNTS=
# Server-side RPC override (falls back to NEXT_PUBLIC_NEAR_RPC_URL)
NEAR_RPC_URL=
# SQLite database file (use a persistent volume in production)
TREZO_DB_PATH=data/trezo.db
# Number of trusted proxies that append to X-Forwarded-For (Railway: 1). Used for per-IP rate limits.
TREZO_TRUSTED_PROXY_HOPS=1

# --- Contract deployment (scripts/deploy-contract.mjs) -----------------------------
# Full-access key of the contract account. Prefer the near-cli keychain instead of setting this.
NEAR_PRIVATE_KEY=
# Owner/admin of the contract (defaults to the contract account)
TREZO_OWNER_ID=
# Public app URL, used as the NEP-245 media base (e.g. https://trezo.example)
TREZO_APP_URL=
# NEAR to seed the Merchant NPC treasury with
TREZO_FUND_MERCHANT_NEAR=0.5
# 1 (default) = lock the economy after configuring it (IRREVERSIBLE). 0 = keep it editable (development only)
TREZO_LOCK_ECONOMY=1
